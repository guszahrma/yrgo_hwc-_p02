# udev rules for P02's boards: fixed serial port names, whatever /dev/ttyACM<n> the board gets, and USB
# access to the Daisy Seed's ROM bootloader. The serial ports get `-echo`: with Linux's default `echo`, the
# board's buffered output was sent straight back when a monitor opened the port, and P02 read it as input.
# Install once, and again after a change (see docs/setup.md):
#   sudo cp tools/udev/99-p02.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger

# Arduino Nano ESP32 -> /dev/tty_arduino_nano_esp32. The ESP32-S3's built-in USB-Serial/JTAG, the same
# under ESP-IDF, Zephyr and the ROM bootloader. Matches any board with that chip: attach one at a time.
# GROUP: Ubuntu's openocd package (60-openocd.rules) gives 303a:1001 to plugdev, the serial port included.
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", GROUP="dialout", SYMLINK+="tty_arduino_nano_esp32", RUN+="/bin/stty -F /dev/%k -echo"

# Daisy Seed -> /dev/tty_daisy_seed, in MCUboot's recovery mode and in the app. 2fe3:0004 is Zephyr's
# default USB ID; the product name is set in the board's Kconfig.defconfig.
SUBSYSTEM=="tty", ATTRS{idVendor}=="2fe3", ATTRS{idProduct}=="0004", ATTRS{product}=="Daisy Seed", SYMLINK+="tty_daisy_seed", RUN+="/bin/stty -F /dev/%k -echo"

# Daisy Seed's ROM bootloader (BOOT + RESET), for dfu-util: the dialout group covers serial ports only.
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="df11", MODE="0660", GROUP="dialout"

# Nucleo-G0B1RE -> /dev/tty_nucleo_g0b1re: the serial port of the on-board ST-Link/V2-1 (USART2 on the
# board). Matches any board with an ST-Link/V2-1 (most Nucleo-64 boards): attach one at a time.
# GROUP: Ubuntu's openocd package (60-openocd.rules) gives everything on an ST-Link to plugdev.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="374b", GROUP="dialout", SYMLINK+="tty_nucleo_g0b1re", RUN+="/bin/stty -F /dev/%k -echo"

# The ST-Link/V2-1 itself, for OpenOCD (west flash): the dialout group covers serial ports only.
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="374b", MODE="0660", GROUP="dialout"
