/*
 * Electrosmith Daisy Seed (Rev7 / Seed 1.2) – hardware shared by all targets of the board.
 *
 * Clocks, the user LED, the pin header and the USB console. SDRAM is added when something needs it.
 */

#include <st/h7/stm32h750Xb.dtsi>
#include <st/h7/stm32h750ibkx-pinctrl.dtsi>
#include "daisy_seed_connector.dtsi"

/ {
	chosen {
		zephyr,sram = &sram0;
	};

	leds {
		compatible = "gpio-leds";

		user_led: led-user {
			gpios = <&gpioc 7 GPIO_ACTIVE_HIGH>; /* PC7, the LED next to the BOOT button */
			label = "User LED";
		};
	};

	aliases {
		led0 = &user_led;
	};
};

/* 48 MHz internal oscillator: the USB clock. */
&clk_hsi48 {
	status = "okay";
};

/* 16 MHz crystal. */
&clk_hse {
	clock-frequency = <DT_FREQ_M(16)>;
	status = "okay";
};

/* 16 MHz / 4 = 4 MHz, x 240 = 960 MHz (VCO); / 2 = 480 MHz CPU clock. */
&pll {
	div-m = <4>;
	mul-n = <240>;
	div-p = <2>;
	div-q = <4>;
	div-r = <4>;
	clocks = <&clk_hse>;
	status = "okay";
};

/* CPU 480 MHz, AHB 240 MHz, APB buses 120 MHz (the chip's maximums). */
&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(480)>;
	d1cpre = <1>;
	hpre = <2>;
	d1ppre = <2>;
	d2ppre1 = <2>;
	d2ppre2 = <2>;
	d3ppre = <2>;
};

&pwr {
	power-supply = "ldo";
};

/* The micro-USB port. The console is a USB serial port (CDC ACM), see Kconfig.defconfig. */
zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";
};

#include <../boards/common/usb/cdc_acm_serial.dtsi>
